---
interface Props {
  tag: string;
  class?: string;
}

const { tag, class: className = '' } = Astro.props;
---

<span
  class:list={[
    'inline-flex items-center rounded-md border border-border bg-surface px-2.5 py-1 text-xs text-cream-muted',
    className,
  ]}
  data-tag={tag}
>
  {tag}
</span>
