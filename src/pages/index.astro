---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import DinnerCard from '../components/DinnerCard.astro';
import RecipeCard from '../components/RecipeCard.astro';
import Icon from '../components/Icon.astro';
import { withBase } from '../lib/url';

const dinners = (await getCollection('dinners')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const recipes = await getCollection('recipes');

const recipeCountByDinner = new Map<string, number>();
for (const recipe of recipes) {
  const dinnerId = recipe.data.dinner?.id;
  if (!dinnerId) continue;
  recipeCountByDinner.set(dinnerId, (recipeCountByDinner.get(dinnerId) ?? 0) + 1);
}

const dinnerTitleById = new Map(dinners.map((d) => [d.id, d.data.title]));

const recentDinners = dinners.slice(0, 3);
const recentRecipes = recipes.slice(0, 6);
---

<BaseLayout title="Home">
  <section class="mx-auto max-w-6xl px-4 pb-16 pt-14 sm:px-6 sm:pt-20">
    <div class="mx-auto max-w-2xl text-center">
      <span class="block text-xs font-semibold uppercase tracking-widest text-coral">the archive</span>
      <h1 class="mt-4 text-4xl font-light leading-tight text-cream sm:text-5xl">
        every dinner, every recipe,<br class="hidden sm:block" /> <em class="text-coral italic">one growing cookbook</em>.
      </h1>
      <p class="mt-4 text-lg text-cream-muted">
        a record of what we've cooked together — and a home for what we'll cook next.
        browse by dinner, search by dish, and add your own when it's your turn.
      </p>
    </div>

    <div class="mx-auto mt-10 flex max-w-xl flex-col items-center gap-3 sm:flex-row sm:justify-center">
      <a
        href={withBase('/dinners')}
        class="inline-flex w-full items-center justify-center gap-2 rounded-lg bg-coral px-6 py-3 font-semibold text-ink transition-colors hover:bg-coral-dark sm:w-auto"
      >
        <Icon name="calendar" class="h-4 w-4" /> browse dinners
      </a>
      <a
        href={withBase('/recipes')}
        class="inline-flex w-full items-center justify-center gap-2 rounded-lg border border-border px-6 py-3 font-semibold text-cream transition-colors hover:border-coral hover:text-coral sm:w-auto"
      >
        <Icon name="bowl" class="h-4 w-4" /> browse recipes
      </a>
    </div>

    <div class="mx-auto mt-14 grid max-w-3xl grid-cols-3 divide-x divide-border rounded-xl border border-border bg-surface py-6 text-center">
      <div>
        <p class="text-3xl font-light text-coral">{dinners.length}</p>
        <p class="text-xs uppercase tracking-wide text-cream-faint">dinners</p>
      </div>
      <div>
        <p class="text-3xl font-light text-coral">{recipes.length}</p>
        <p class="text-xs uppercase tracking-wide text-cream-faint">recipes</p>
      </div>
      <div>
        <p class="text-3xl font-light text-coral">
          {new Set(recipes.flatMap((r) => r.data.tags)).size}
        </p>
        <p class="text-xs uppercase tracking-wide text-cream-faint">tags</p>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 pb-16 sm:px-6">
    <div class="mb-6 flex items-center justify-between">
      <h2 class="text-2xl font-light text-cream">recent dinners</h2>
      <a href={withBase('/dinners')} class="inline-flex items-center gap-1 text-sm text-coral hover:underline">
        see all <Icon name="arrow-right" class="h-3.5 w-3.5" />
      </a>
    </div>
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        recentDinners.map((dinner) => (
          <DinnerCard dinner={dinner} recipeCount={recipeCountByDinner.get(dinner.id) ?? 0} />
        ))
      }
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 pb-24 sm:px-6">
    <div class="mb-6 flex items-center justify-between">
      <h2 class="text-2xl font-light text-cream">recipes worth remembering</h2>
      <a href={withBase('/recipes')} class="inline-flex items-center gap-1 text-sm text-coral hover:underline">
        see all <Icon name="arrow-right" class="h-3.5 w-3.5" />
      </a>
    </div>
    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {
        recentRecipes.map((recipe) => (
          <RecipeCard
            recipe={recipe}
            dinnerTitle={recipe.data.dinner ? dinnerTitleById.get(recipe.data.dinner.id) : undefined}
          />
        ))
      }
    </div>
  </section>
</BaseLayout>
