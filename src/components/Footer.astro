---
import BrandMark from './BrandMark.astro';
---

<footer class="mt-24 border-t border-border">
  <div class="mx-auto max-w-6xl px-4 py-10 sm:px-6">
    <div class="flex flex-col items-start justify-between gap-6 sm:flex-row sm:items-center">
      <div class="flex items-center gap-3 text-cream">
        <BrandMark class="h-4 w-auto text-coral" />
        <p class="text-base font-semibold">moku pona</p>
      </div>
      <p class="max-w-md text-sm text-cream-muted">
        a living archive of our dinners and recipes — and, one day, the moku pona cookbook.
      </p>
    </div>
    <p class="mt-8 text-xs text-cream-faint">made with love in zürich</p>
  </div>
</footer>
