---
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import TagPill from '../../components/TagPill.astro';
import { withBase } from '../../lib/url';

export async function getStaticPaths() {
  const recipes = await getCollection('recipes');
  return recipes.map((recipe) => ({
    params: { slug: recipe.id },
    props: { recipe },
  }));
}

const { recipe } = Astro.props;
const {
  title,
  description,
  image,
  servings,
  prepTime,
  cookTime,
  difficulty,
  tags,
  ingredients,
  steps,
  notes,
  dinner: dinnerRef,
} = recipe.data;

const dinner = dinnerRef ? await getEntry(dinnerRef) : undefined;
---

<BaseLayout title={title} description={description}>
  <article class="mx-auto max-w-3xl px-4 py-14 sm:px-6">
    <a href={withBase('/recipes')} class="inline-flex items-center gap-1 text-sm text-cream-faint hover:text-coral">
      <Icon name="arrow-right" class="h-3.5 w-3.5 rotate-180" /> all recipes
    </a>

    {
      image && (
        <img
          src={withBase(image)}
          alt={title}
          class="mt-6 aspect-[2/1] w-full rounded-xl object-cover"
        />
      )
    }

    <h1 class="mt-6 text-4xl font-light text-cream sm:text-5xl">{title}</h1>
    {description && <p class="mt-3 text-lg text-cream-muted">{description}</p>}

    <div class="mt-6 flex flex-wrap items-center gap-x-6 gap-y-2 text-sm text-cream-muted">
      {
        dinner && (
          <a
            href={withBase(`/dinners/${dinner.id}/`)}
            class="inline-flex items-center gap-1.5 hover:text-coral hover:underline"
          >
            <Icon name="calendar" class="h-4 w-4" /> from {dinner.data.title}
          </a>
        )
      }
      {
        (prepTime || cookTime) && (
          <span class="inline-flex items-center gap-1.5">
            <Icon name="clock" class="h-4 w-4" />
            {[prepTime && `${prepTime} prep`, cookTime && `${cookTime} cook`].filter(Boolean).join(' + ')}
          </span>
        )
      }
      {
        servings && (
          <span class="inline-flex items-center gap-1.5">
            <Icon name="users" class="h-4 w-4" /> serves {servings}
          </span>
        )
      }
      {
        difficulty && (
          <span class="rounded-md border border-border px-2.5 py-1 text-xs text-cream-muted">
            {difficulty}
          </span>
        )
      }
    </div>

    {
      tags.length > 0 && (
        <div class="mt-4 flex flex-wrap gap-1.5">
          {tags.map((tag) => (
            <TagPill tag={tag} />
          ))}
        </div>
      )
    }

    <div class="mt-10 grid gap-10 sm:grid-cols-[1fr_1.6fr]">
      {
        ingredients.length > 0 && (
          <div>
            <h2 class="text-xl font-light text-cream">ingredients</h2>
            <ul class="mt-4 space-y-2.5">
              {ingredients.map((item) => (
                <li class="flex items-start gap-2.5 text-cream-muted">
                  <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-coral" />
                  {item}
                </li>
              ))}
            </ul>
          </div>
        )
      }

      {
        steps.length > 0 && (
          <div>
            <h2 class="text-xl font-light text-cream">method</h2>
            <ol class="mt-4 space-y-5">
              {steps.map((step, i) => (
                <li class="flex gap-4">
                  <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full border border-coral/40 text-sm text-coral">
                    {i + 1}
                  </span>
                  <p class="pt-0.5 leading-relaxed text-cream-muted">{step}</p>
                </li>
              ))}
            </ol>
          </div>
        )
      }
    </div>

    {
      notes && (
        <div class="mt-10 rounded-xl border border-coral/25 bg-surface p-5">
          <p class="font-semibold text-cream">note</p>
          <p class="mt-1 leading-relaxed text-cream-muted">{notes}</p>
        </div>
      )
    }
  </article>
</BaseLayout>
