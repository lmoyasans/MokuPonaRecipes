---
import type { CollectionEntry } from 'astro:content';
import Icon from './Icon.astro';
import { withBase } from '../lib/url';

interface Props {
  dinner: CollectionEntry<'dinners'>;
  recipeCount: number;
}

const { dinner, recipeCount } = Astro.props;
const { title, date, theme } = dinner.data;

const formattedDate = date.toLocaleDateString('en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
const month = date.toLocaleDateString('en-GB', { month: 'short' }).toLowerCase();
const day = date.getDate();
---

<a
  href={withBase(`/dinners/${dinner.id}/`)}
  class="group flex gap-4 rounded-xl border border-border bg-surface p-4 transition-colors hover:border-coral/40 sm:gap-5 sm:p-5"
>
  <div class="flex h-16 w-16 shrink-0 flex-col items-center justify-center rounded-lg bg-surface-raised text-coral sm:h-20 sm:w-20">
    <span class="text-xs uppercase tracking-wide opacity-80">{month}</span>
    <span class="text-2xl font-light leading-none sm:text-3xl">{day}</span>
  </div>
  <div class="flex flex-1 flex-col justify-center gap-1">
    <p class="text-xs text-cream-faint">{formattedDate}</p>
    <h3 class="text-xl font-light text-cream group-hover:text-coral">
      {title}
    </h3>
    {theme && <p class="text-sm text-cream-muted">{theme}</p>}
    <div class="mt-1 flex flex-wrap items-center gap-x-4 gap-y-1 text-xs text-cream-faint">
      <span class="inline-flex items-center gap-1">
        <Icon name="bowl" class="h-3.5 w-3.5" /> {recipeCount} recipe{recipeCount === 1 ? '' : 's'}
      </span>
    </div>
  </div>
  <Icon
    name="arrow-right"
    class="h-5 w-5 shrink-0 self-center text-cream-faint transition-transform group-hover:translate-x-1 group-hover:text-coral"
  />
</a>
